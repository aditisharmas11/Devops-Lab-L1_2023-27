pipeline {
    agent none

    options {
        disableConcurrentBuilds()
    }

    environment {
        PROJECT_DIR = '23070122047_ArshAnsari/Project4-Distributed-Jenkins-Maven'
    }

    stages {
        stage('Checkout') {
            agent { label 'slave-1' }
            steps {
                checkout scm
                stash name: 'source', includes: '**/*', excludes: '**/.git/**'
            }
        }

        stage('Build') {
            agent { label 'slave-1' }
            steps {
                unstash 'source'
                dir("${PROJECT_DIR}") {
                    sh 'hostname && mvn -B -q clean compile'
                }
                stash name: 'compiled', includes: '**/*', excludes: '**/.git/**'
            }
        }

        stage('Test') {
            agent { label 'slave-2' }
            steps {
                unstash 'compiled'
                dir("${PROJECT_DIR}") {
                    sh 'hostname && mvn -B test'
                }
                junit allowEmptyResults: false, testResults: "${PROJECT_DIR}/target/surefire-reports/*.xml"
                stash name: 'tested', includes: '**/*', excludes: '**/.git/**'
            }
        }

        stage('Package') {
            agent { label 'slave-1' }
            steps {
                unstash 'tested'
                dir("${PROJECT_DIR}") {
                    sh 'hostname && mvn -B package -DskipTests'
                }
                archiveArtifacts artifacts: "${PROJECT_DIR}/target/*.jar", fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'Distributed Maven pipeline completed on slave-1 and slave-2.'
        }
        failure {
            echo 'Distributed Maven pipeline failed. Check the stage that ran on slave-1 or slave-2.'
        }
    }
}
