pipeline {
    agent none

    stages {
        stage('Compile') {
            agent { label 'agent1' }
            steps {
                echo 'Checking out source code on agent 1...'
                checkout scm
                
                echo 'Compiling Maven project on agent 1...'
                bat 'mvn clean compile'
            }
        }

        stage('Test') {
            agent { label 'agent2' }
            steps {
                echo 'Checking out source code on agent 2...'
                checkout scm
                
                echo 'Testing Maven project on agent 2...'
                bat 'mvn test'
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution finished.'
        }
        success {
            echo 'Build and Test successful across distributed nodes!'
        }
        failure {
            echo 'Pipeline failed.'
        }
    }
}