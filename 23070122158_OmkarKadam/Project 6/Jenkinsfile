pipeline {
    agent any

    environment {
        // Change 'dockerhub-credentials-id' to your actual Jenkins credentials ID for DockerHub
        DOCKERHUB_CREDENTIALS_ID = 'dockerhub-credentials-id'
        // Change 'yourdockerhubusername' to your actual DockerHub username
        IMAGE_NAME = "yourdockerhubusername/portfolio-app"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Build Maven Project') {
            steps {
                echo '=== STAGE: Build Maven Project ==='
                script {
                    if (isUnix()) {
                        sh 'mvn clean package'
                    } else {
                        bat 'mvn clean package'
                    }
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                echo '=== STAGE: Build Docker Image ==='
                script {
                    // Requires the Docker Pipeline plugin installed on Jenkins
                    appImage = docker.build("${IMAGE_NAME}:${IMAGE_TAG}")
                }
            }
        }
        
        stage('Push Image to DockerHub') {
            steps {
                echo '=== STAGE: Push Image to DockerHub ==='
                script {
                    // Authenticate and push to DockerHub registry
                    docker.withRegistry('https://index.docker.io/v1/', DOCKERHUB_CREDENTIALS_ID) {
                        appImage.push()
                        appImage.push('latest')
                    }
                }
            }
        }
    }

    post {
        always {
            echo '=== Pipeline Execution Completed ==='
            // Clean up dangling local images
            script {
                if (isUnix()) {
                    sh "docker rmi ${IMAGE_NAME}:${IMAGE_TAG} || true"
                } else {
                    bat "docker rmi ${IMAGE_NAME}:${IMAGE_TAG} || exit 0"
                }
            }
        }
        success {
            echo 'Build, Image Creation, and Push to DockerHub Succeeded!'
        }
        failure {
            echo 'Pipeline failed. Please inspect the logs.'
        }
    }
}
