pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing Python dependencies...'
                sh 'python3 -m pip install -r requirements.txt'
            }
        }

        stage('Test') {
            steps {
                echo 'Running automated tests...'
                sh 'python3 -m pytest'
            }
        }

        stage('Docker Build') {
            steps {
                echo 'Building Docker image...'
                sh 'docker build -t jenkins-flask-app .'
            }
        }

        stage('Docker Deploy') {
            steps {
                echo 'Deploying Docker container...'
                sh 'docker stop jenkins-flask-container || true'
                sh 'docker rm jenkins-flask-container || true'
                sh 'docker run -d -p 5000:5000 --name jenkins-flask-container jenkins-flask-app'
            }
        }
    }

    post {
        success {
            echo '======================================'
            echo 'CI/CD PIPELINE SUCCESSFUL!'
            echo '======================================'
        }

        failure {
            echo '======================================'
            echo 'CI/CD PIPELINE FAILED!'
            echo '======================================'
        }
    }
}