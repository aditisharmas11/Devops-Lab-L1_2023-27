pipeline {
    agent any

    environment {
        IMAGE_NAME = "retailhub"
        IMAGE_TAG  = "1.0.0"
        DTR_REGISTRY = "dtr.retail.internal"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "Source code checked out"
            }
        }

        stage('Build JAR') {
            steps {
                dir('23070122008_AayushJoshi/Project5-SpringBoot-DTR-Docker') {
                    sh 'mvn clean package -DskipTests -B'
                }
                echo "JAR built successfully"
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('23070122008_AayushJoshi/Project5-SpringBoot-DTR-Docker') {
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
                    sh "docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${DTR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
                }
                echo "Docker image built and tagged for DTR"
            }
        }

        stage('Scan Image with Trivy (DTR)') {
            steps {
                sh """
                    docker run --rm \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        -v \$HOME/.cache:/root/.cache \
                        aquasec/trivy:latest image \
                        --exit-code 0 \
                        --severity HIGH,CRITICAL \
                        --format table \
                        ${IMAGE_NAME}:${IMAGE_TAG}
                """
                echo "Image scan complete — DTR security report generated"
            }
        }

        stage('Push to DTR') {
            steps {
                echo "Pushing ${DTR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} to Docker Trusted Registry"
                sh "docker push ${DTR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} || echo 'DTR push simulated (no live registry in lab)'"
            }
        }

        stage('Deploy') {
            steps {
                dir('23070122008_AayushJoshi/Project5-SpringBoot-DTR-Docker') {
                    sh 'docker compose down || true'
                    sh 'docker compose up -d'
                }
                echo "RetailHub deployed at http://localhost:8080"
            }
        }
    }

    post {
        success {
            echo "Pipeline SUCCESS — RetailHub is live and image scanned"
        }
        failure {
            echo "Pipeline FAILED — check logs above"
        }
    }
}
